# === Mike AI SaaS Configuration ===

# Telegram
TELEGRAM_BOT_TOKEN=put_telegram_bot_token_here
OWNER_TELEGRAM_ID=0

# Company
COMPANY_NAME=Компания
BOT_NAME=Ассистент
WELCOME_MESSAGE=Здравствуйте! Я ассистент компании {COMPANY_NAME}. Чем могу помочь?

# Auth
WEB_PASSWORD=change_me
API_KEY=

# SaaS / Multi-tenant
TENANT_ID=default

# Tone: friendly (на ты, живой), professional (на вы, формальный), casual (максимально простой)
BOT_TONE=friendly

# LLM
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=deepseek/deepseek-r1
MAX_LLM_TOKENS=900
LLM_TIMEOUT_SECONDS=35

# RAG
RAG_CONFIDENCE_THRESHOLD=0.72
MIN_RAG_SCORE=0.72
TOP_K_RESULTS=4
CHUNK_SIZE=1500
CHUNK_OVERLAP=150
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Limits
DAILY_REQUEST_LIMIT=500
MONTHLY_TOKEN_LIMIT=500000
RATE_LIMIT_SECONDS=2
MAX_FILES_PER_TENANT=20
MAX_FILE_SIZE_MB=10
MAX_UPLOAD_MB=10
MAX_CHUNKS_PER_TENANT=5000
MIN_TEXT_LENGTH=200

# Cache
CACHE_TTL_HOURS=24

# Telegram mode: polling (default) or webhook
TELEGRAM_MODE=polling
WEBHOOK_URL=
WEBHOOK_PORT=8443

# VK Bot (optional)
VK_ENABLED=false
VK_GROUP_TOKEN=
VK_GROUP_ID=0
# Как получить: Управление сообществом → Работа с API → Создать ключ → Разрешить сообщения
# VK_GROUP_ID: число из ссылки группы (vk.com/club123456789 → 123456789)

# Widget (чат на сайте клиента)
WIDGET_ENABLED=true
# Виджет работает через API_KEY. Код для вставки: http://localhost:8000/widget/code

# Notifications
NOTIFY_OWNER=true
